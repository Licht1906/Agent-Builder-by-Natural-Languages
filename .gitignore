# AI logs — tracked structure, ignored content
# `**/` so a stray .ai-log/ outside the repo root is ignored too
**/.ai-log/*.jsonl
**/.ai-log/archive/

# Personal prompt-redaction customization (Claude only) — not a shared
# team mechanism; log_hook.py/submit_log.py import it defensively and work
# without it. .ai-log/.claude_pending.jsonl is covered by .ai-log/*.jsonl above.
scripts/redact.py
scripts/llm_redact.py
tests/test_scripts/

# UC1-37 (#149) — scripts/run_ac_checklist.py's own dated evidence reports.
# Tracked structure (the directory + this note), ignored content: each real
# run produces a new timestamped file, the same "structure in, generated
# content out" shape .ai-log/ above already uses.
docs/usecase_spec/uc1-ar-assistant/ac_checklist_evidence/*.md
!docs/usecase_spec/uc1-ar-assistant/ac_checklist_evidence/README.md

# Firebase CLI
firebase-debug.log
.firebase/
