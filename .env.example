# ============================================
# Agent Builder by Natural Languages — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# Postgres only — no SQLite. `docker-compose up` gives you a `db` service that
# matches these defaults; see issue #3 for why SQLite is not an option.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev

# ---- Knowledge search / RAG (ADR-0045) ----
# Model nhúng cho node `KnowledgeSearch`. Nhà cung cấp được đọc từ CHÍNH TÊN
# model: `text-embedding-*` = OpenAI (dùng OPENAI_API_KEY ở trên),
# `voyage-*` = Voyage (dùng VOYAGE_API_KEY bên dưới).
#
# Bỏ trống thì tìm kiếm vẫn chạy — chỉ lùi về xếp hạng bằng từ khoá, sẽ trượt
# những câu hỏi diễn đạt khác tài liệu.
#
# Danh sách theo thứ tự ưu tiên: chạm trần model đầu thì tự chuyển sang model
# sau, hết tất cả thì về từ khoá. Ghi một model = "dừng lại khi hết".
# Lưu ý: đổi model sẽ index lại toàn bộ thư viện, vì vector của hai model không
# so sánh được với nhau. Mọi model đều được xin đúng 1024 chiều nên không cần
# migration.
EMBEDDING_MODEL=voyage-4
# Trần token cho MỖI model, 0 = không giới hạn. Đặt 200000000 nếu muốn giữ
# Voyage trong phạm vi free tier; OpenAI vẫn được ghi nhận usage trong ledger.
# Xem đã dùng bao nhiêu: GET /api/v1/admin/embedding-usage (cần quyền admin).
EMBEDDING_TOKEN_ALLOWANCE=0
# Chỉ cần khi EMBEDDING_MODEL có model `voyage-*`. Lưu ý free tier của Voyage bị
# giới hạn 3 request/phút cho tới khi thêm phương thức thanh toán.
VOYAGE_API_KEY=

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# Qdrant (RAG-01). `docker-compose up` gives you a `qdrant` service reachable
# at this default; run `python scripts/init_qdrant.py` once to provision the
# `documents_kb` collection.
QDRANT_URL=http://localhost:6333

# Hệ CSDL (DS-02). "Kiểm tra kết nối" chặn mọi địa chỉ nội bộ (ssrf_guard),
# mà DB mẫu/staging thường nằm trong mạng nội bộ. Liệt kê ở đây — cách nhau
# bằng dấu phẩy, viết đúng như host trong DSN — những host được phép gọi tới
# dù là địa chỉ nội bộ. Để trống: chỉ địa chỉ công khai.
#
# Đừng thêm localhost/127.0.0.1 trên máy chủ dùng chung: mọi người tạo agent
# sẽ dò được các dịch vụ chạy trên chính máy chủ nền tảng. Ghi đúng tên host
# của DB mẫu, ví dụ tên service trong docker-compose: erp-demo
DATABASE_SOURCE_TRUSTED_HOSTS=

# Embeddings cho Qdrant (RAG-02) dùng CHUNG `EMBEDDING_MODEL` khai báo ở phần
# trên — KHÔNG có biến thứ hai ở đây.
#
# Chỗ này từng đặt EMBEDDING_MODEL=bge-m3:567m qua Ollama, và vì nó đứng SAU
# nên nó thắng: dòng `voyage-4,text-embedding-3-small` phía trên chưa bao giờ
# có hiệu lực ở bất kỳ deployment nào. Ollama chạy tốt trên máy operator nhưng
# không tồn tại trên Cloud Run, nơi localhost:11434 không trả lời gì — và
# ingestion không suy giảm, nó hỏng theo từng tài liệu: `failed (0 passages)`,
# một knowledge base tồn tại và rỗng. Embedding giờ đi qua Voyage/OpenAI
# (ADR-0045 §3), cùng đường mà search đã dùng.

# Reranker (RAG-03). `docker-compose up` gives you a `reranker` service
# reachable at this default. The backend degrades gracefully — an unranked
# result with a warning, not a 500 — when this is unreachable; see
# src/services/reranker.py.
RERANKER_URL=http://localhost:8001

# Ba con số dưới đây là MỘT quyết định, không phải ba. Reranker là việc
# CPU-bound thuần, và mỗi search gửi cho nó `max(DENSE_TOP_K, SPARSE_TOP_K)`
# ứng viên — RRF gộp hai nhánh prefetch lại chứ không cộng chúng, nên 20/20 ở
# đây là 20 ứng viên tới reranker, không phải 40. Đo trên bge-reranker-v2-m3:
#
#     ứng viên │  2 vCPU │  4 vCPU │  8 vCPU
#     ─────────┼─────────┼─────────┼─────────
#           10 │ 14.68s  │  7.01s  │  2.83s
#           20 │ 25.58s  │ 12.26s  │  5.52s
#
# Đổi top_k mà không xem lại CPU của reranker là cách một deployment timeout
# trên mọi search — và nó hỏng IM LẶNG: `src/services/reranker.py` cố ý không
# raise, chỉ trả lại thứ tự chưa xếp kèm một dòng warning. Đo được: hit@8
# 19/22 → 16/22, MRR 0.742 → 0.498. Xem DEPLOYMENT.md §Sizing.
#
# Hạ top_k xuống 10 là đánh đổi CHẤT LƯỢNG (đo được 17/22, MRR 0.683); hạ CPU
# chỉ là đánh đổi latency. Cần cắt tiền thì cắt CPU trước.
KNOWLEDGE_DENSE_TOP_K=20
KNOWLEDGE_SPARSE_TOP_K=20
# Biên an toàn, không phải mục tiêu: chạm tới nghĩa là reranker thiếu CPU.
RERANKER_TIMEOUT_SECONDS=30

# No Vault (DS-20): every credential the platform holds is in its SecretStore —
# a Postgres table encrypted with SECRET_STORE_KEY. Nothing to run or unseal.
# Required in production (APP_ENV=production refuses the dev default), ≥32 chars:
#   openssl rand -hex 32
# Changing it makes every stored secret unreadable until re-entered.
# SECRET_STORE_KEY=

# Control plane (UC1-26 / #142). Empty by default — leaving this unset is the
# correct, honest state for a fresh install: nothing calls out until someone
# explicitly pulls a template via POST /control-plane/templates/{id}/pull.
# CONTROL_PLANE_PUBLIC_KEY is the vendor's Ed25519 public key, base64-encoded;
# see src/services/control_plane.py.
CONTROL_PLANE_URL=
CONTROL_PLANE_PUBLIC_KEY=

# OpenRouter — get a key at https://openrouter.ai/keys. Two things run on it:
#
#  1. The agent con (§6.3, `AGENT_MODEL` in src/models/model_catalog.py) —
#     `qwen/qwen-2.5-7b-instruct`. Note the slug is OpenRouter's, NOT the
#     Hugging Face repo id `Qwen/Qwen2.5-7B-Instruct`; OpenRouter 404s on that.
#     This is not settable here on purpose: which model a signed-off agent runs
#     on is a code constant (ADR-0010 §1), not a per-deployment knob.
#  2. Extraction (RAG-06) — scanned/photographed PDF pages through a vision
#     model. Text-native PDFs and .md/.txt/.docx never call it (see
#     src/services/extraction.py).
#
# So an empty key now costs you every agent chat turn, not just scanned-page
# ingest. src/services/llm.py refuses to build the model rather than letting it
# fail as a 401 from inside a LangGraph node.
#
# Both URLs must name the same host. OPENROUTER_URL is a complete endpoint
# (raw httpx POST, extraction). OPENROUTER_BASE_URL is the API root — ChatOpenAI
# appends /chat/completions itself, so putting the full endpoint there produces
# .../chat/completions/chat/completions.
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_VLM_MODEL=qwen/qwen3-vl-32b-instruct
# Cached by the file's own SHA-256 — re-uploading the same file does not call
# OpenRouter a second time.
EXTRACTION_CACHE_DIR=./data/extraction_cache

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Auth (ticket #4) ----
# MUST be set to a long random value anywhere the app is reachable — the code
# default is a development placeholder and is public.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=60
# Demo accounts seeded by the migrations, one per role. Change the passwords
# before deploying anywhere real.
SEED_CREATOR_EMAIL=creator@example.com
SEED_CREATOR_PASSWORD=creator-dev-password
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-dev-password

# UC1-01 (#117), FR-03: the agent_admin account every install starts already
# activated — everyone who registers after it is `pending` until this
# account (or one it activates) calls POST /admin/users/{id}/activate.
SEED_AGENT_ADMIN_EMAIL=agent-admin@example.com
SEED_AGENT_ADMIN_PASSWORD=agent-admin-dev-password

# ADR-0051: the PM control room's own account (role `pm`, not an admin).
# Reads the six-widget board and pulls its levers; nothing else.
SEED_PM_EMAIL=pm@example.com
SEED_PM_PASSWORD=pm-dev-password

# ---- LangSmith (AI Logs — Deliverable #4) ----
# Read by LangChain itself, not by anything in `src/` — `docker-compose.yml`
# passes this file into the backend container with `env_file`, which is what
# puts them where LangChain looks.
#
# Tracing ships **off**: turning it on next to the placeholder key below makes
# every LLM call attempt a trace upload and take `403 Forbidden` back from
# api.smith.langchain.com, once per call, in a log that is otherwise where you
# go to find real failures. Set the key first, then flip this to `true`.
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-builder
LANGCHAIN_TRACING_V2=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Tools (real implementations; leave empty to keep a tool unconfigured) ----
# web_search — key lấy miễn phí tại https://app.tavily.com (1.000 credit/tháng,
# không cần thẻ). Mỗi lần search tốn 1 credit vì node dùng search_depth=basic.
# Bỏ trống thì node `web_search` báo "chưa cấu hình" vào transcript và run vẫn
# chạy tiếp — xem ADR-0032.
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search
# send_email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# Thư mục tài liệu của hệ thống. Hai thứ đọc trong đây và không được ra khỏi đây:
# tool `read_file` của V1, và node `Tìm trong tài liệu` (KnowledgeSearch) của V2 —
# `source_ids` của node là đường dẫn tương đối tính từ thư mục này.
TOOL_FILE_BASE_DIR=./data/workspace
# web_search + http_request
TOOL_HTTP_TIMEOUT_SECONDS=15

# ---- Google OAuth (UserConnection — per-user Gmail/Drive) ----
# Tạo OAuth client (loại "Web application") tại console.cloud.google.com →
# APIs & Services → Credentials, bật Gmail API + Drive API, và thêm
# GOOGLE_OAUTH_REDIRECT_URL bên dưới vào "Authorized redirect URIs" — phải
# khớp từng ký tự. Bỏ trống thì nút "Kết nối Google" báo "chưa cấu hình";
# hai kết nối gmail/google_drive từ chối chạy thật cho tới khi người dùng nối
# tài khoản của chính họ.
#
# CỔNG PHẢI KHỚP BACKEND. Vite proxy trỏ tới 8065 (frontend/.env.local), nên
# chạy local là 8065 chứ không phải 8000 — Google gọi về cổng sai thì trình
# duyệt nhận "không kết nối được" và không ai biết vì sao.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8065/api/v1/user-connections/google/callback
# Sau khi callback xong trình duyệt được đưa về đây (màn hình Connections).
FRONTEND_URL=http://localhost:5173

# ---- Model cham eval (ADR-0054 §4) ----
# De trong = dung META_AGENT_MODEL. Bai giang AI Evaluation (s52): judge nen
# khac ho model voi generator, va mot judge re hon nhieu lan van du cho mot
# phan quyet nhi phan. Doi gia tri nay la doi baseline — `eval_runs.judge_model`
# ghi lai model da cham tung lan, va report khong so delta giua hai judge khac nhau.
JUDGE_MODEL=gpt-4.1-mini

# ---- Observability: Langfuse (ticket #11) ----
# Để trống cả hai key = không trace. Hệ thống chạy y hệt, chi phí vẫn được ghi
# lại đầy đủ trong bảng `run_costs`; chỉ mất phần trace để điều tra sự cố.
# Trace không bao giờ chặn một lần chạy — xem src/services/tracing.py.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Tự host: `docker compose -f docker-compose.langfuse.yml up -d` rồi
#   LANGFUSE_HOST=http://localhost:3000  LANGFUSE_PUBLIC_KEY=pk-lf-agentlab-local
#   LANGFUSE_SECRET_KEY=sk-lf-agentlab-local  LANGFUSE_PROJECT_ID=agentlab-local
# (key và project được tạo sẵn lúc container khởi động — xem file compose).
# LANGFUSE_PROJECT_ID chỉ để bảng PM bấm "mở trace" ra đúng URL; để trống = không có link.
LANGFUSE_PROJECT_ID=

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (ticket #8) ----
# The Next.js app in `frontend/` reads its own `frontend/.env.local`; see
# `frontend/.env.example`. Nothing here is used by it.
#
# `CORS_ORIGINS` above still matters only for direct browser → FastAPI calls.
# The frontend does not make any: the browser talks to Next, and Next talks to
# FastAPI server-side (ADR-0006 §7).
