yDy=0;" edge="1" parent="1" source="g2" target="g10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="chạy tiếp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="mỗi node, mỗi lần" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=0.96;exitY=1;exitDx=0;exitDy=0;entryX=0.96;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="g16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="4._Data_flow_—_Hybrid_RAG_(ADR-0045)" name="4. Data flow — Hybrid RAG (ADR-0045)"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Hai nửa của một node knowledge_search: đưa tài liệu vào chỉ mục (chạy khi tài liệu đổi) và trả lời một câu hỏi&lt;br&gt;(chạy mỗi lượt). Hai nửa gặp nhau ở đúng một bảng — document_chunks." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="55" as="geometry"/></mxCell><mxCell id="g2" value="A · Đưa tài liệu vào chỉ mục — chạy lại khi tài liệu đổi" style="swimlane;html=1;startSize=28;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="585" as="geometry"/></mxCell><mxCell id="n3" value="POST /api/v1/documents&lt;br&gt;PDF · DOCX · MD · TXT" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g2"><mxGeometry x="20" y="45" width="480" height="60" as="geometry"/></mxCell><mxCell id="n4" value="Bóc văn bản — pypdf (PDF) · python-docx (DOCX)&lt;br&gt;DOCX gộp ô của một hàng bảng bằng ' · '" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="g2"><mxGeometry x="20" y="135" width="480" height="70" as="geometry"/></mxCell><mxCell id="n5" value="Cắt đoạn ngữ nghĩa — semantic_chunks_of()&lt;br&gt;cắt theo tiêu đề Markdown và Điều / CHƯƠNG,&lt;br&gt;rồi cắt tiếp ở chỗ ý nghĩa đổi (percentile 85)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="g2"><mxGeometry x="20" y="235" width="480" height="90" as="geometry"/></mxCell><mxCell id="n6" value="Embed từng đoạn&lt;br&gt;text-embedding-3-small · 1024 chiều" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="g2"><mxGeometry x="20" y="355" width="480" height="70" as="geometry"/></mxCell><mxCell id="n7" value="Chỉ mục tự vô hiệu khi một trong ba thứ đổi:&lt;br&gt;hash nội dung tệp · CHUNKER_VERSION · tên model embedding.&lt;br&gt;&lt;br&gt;Vector của hai model khác nhau không so được với nhau, kể cả gần đúng — nên đổi model là lập lại chỉ mục, không có đường tắt." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="g2"><mxGeometry x="20" y="455" width="480" height="110" as="geometry"/></mxCell><mxCell id="n8" value="Vì sao phải lai hai kiểu tìm?&lt;br&gt;&lt;br&gt;BM25 bắt đúng từ khoá hiếm — mã số, tên điều, tên riêng. Embedding bắt ý khi người hỏi dùng chữ khác hẳn tài liệu. Thiếu nửa nào cũng hụt một loại câu hỏi." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="600" y="130" width="300" height="150" as="geometry"/></mxCell><mxCell id="n9" value="document_chunks&lt;br&gt;text · heading_path · embedding vector(1024)&lt;br&gt;content_hash · chunker_version · embedding_model" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="300" height="140" as="geometry"/></mxCell><mxCell id="n10" value="Ngưỡng điểm &gt; 0 cho phép trả về RỖNG.&lt;br&gt;&lt;br&gt;Đó là thứ giúp agent nói 'quy chế không quy định' thay vì trích đại một đoạn không liên quan. Im lặng đúng còn hơn trả lời sai." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="600" y="500" width="300" height="160" as="geometry"/></mxCell><mxCell id="g11" value="B · Trả lời một câu hỏi — đọc chunk của đúng các ref đã gắn, chạy mỗi lượt" style="swimlane;html=1;startSize=28;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="680" height="625" as="geometry"/></mxCell><mxCell id="n12" value="Câu hỏi của người dùng&lt;br&gt;_retrieval_query()" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g11"><mxGeometry x="200" y="45" width="280" height="56" as="geometry"/></mxCell><mxCell id="n13" value="BM25 trong tiến trình&lt;br&gt;unigram + bigram tiếng Việt&lt;br&gt;IDF tính trên đúng tập tài liệu được gắn" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="g11"><mxGeometry x="20" y="140" width="290" height="95" as="geometry"/></mxCell><mxCell id="n14" value="pgvector&lt;br&gt;ORDER BY embedding &lt;=&gt; :vector&lt;br&gt;cosine, quét thẳng (chưa có ANN index)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="g11"><mxGeometry x="370" y="140" width="290" height="95" as="geometry"/></mxCell><mxCell id="n15" value="Hợp nhất Reciprocal Rank Fusion&lt;br&gt;fuse(lexical[:20], semantic[:20])&lt;br&gt;chỉ đọc thứ hạng, khỏi cân trọng số" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="g11"><mxGeometry x="200" y="275" width="280" height="90" as="geometry"/></mxCell><mxCell id="n16" value="Lọc lần cuối&lt;br&gt;bỏ đoạn trùng (Jaccard ≥ 0.85)&lt;br&gt;tối đa 2 đoạn mỗi mục · lấy 6 đoạn" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="g11"><mxGeometry x="200" y="405" width="280" height="90" as="geometry"/></mxCell><mxCell id="n17" value="6 passage kèm [source_ref]&lt;br&gt;ghép vào prompt của node agent_llm" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="g11"><mxGeometry x="200" y="535" width="280" height="70" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="ghi 1 lần" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="g11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="từ khoá" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="vector câu hỏi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="top 20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="top 20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>